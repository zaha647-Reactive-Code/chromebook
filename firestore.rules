rules_version = '2';
// MyChromebook.pk — Firestore security rules (report section 6.4).
// Publish these in the Firebase console BEFORE adding real data.
service cloud.firestore {
  match /databases/{database}/documents {
    function isAdmin() {
      return request.auth != null && request.auth.token.admin == true;
    }

    // catalogue: everyone can read, only admins change it
    match /products/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /posts/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }
    match /settings/{id} {
      allow read: if true;
      allow write: if isAdmin();
    }

    // orders: created by the server only; the customer who owns it and admins can read
    match /orders/{id} {
      allow read: if isAdmin()
        || (request.auth != null && resource.data.userId == request.auth.uid);
      allow create: if false;
      allow update, delete: if isAdmin();
    }

    // each customer's own profile, addresses and wishlist
    match /users/{uid} {
      allow read, write: if request.auth != null && request.auth.uid == uid;
    }

    // contact messages: saved by the server, read by admins
    match /messages/{id} {
      allow read, update: if isAdmin();
      allow create, delete: if false;
    }

    // outgoing email queue (Trigger Email extension): server only
    match /mail/{id} {
      allow read, write: if false;
    }
  }
}
